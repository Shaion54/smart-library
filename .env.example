# ==============================================================================
# Smart Library Seat Finder - Environment Variables Configuration
# Copy this file to .env.local and fill in the values
# ==============================================================================

# Supabase Public API (Accessible in browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key

# Supabase Privileged Key (SERVER-SIDE ONLY - NEVER expose in client or ESP8266)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key

# Secret token used by ESP8266 NodeMCU to authenticate device updates to /api/device/*
DEVICE_API_TOKEN=your-random-strong-device-secret-token-here

# Configuration Parameters (Optional defaults)
NEXT_PUBLIC_DEFAULT_RESERVATION_MINUTES=30
DEVICE_OFFLINE_TIMEOUT_SECONDS=60
